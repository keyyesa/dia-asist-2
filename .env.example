# Copy this file to .env and edit as needed.
# (Most of these can also be changed from the Settings page inside the app.)

# LLM backend: "ollama" (offline, free, runs on your PC) or "gemini" (cloud API)
LLM_BACKEND=ollama

# --- Ollama settings (used when LLM_BACKEND=ollama) ---
# Install from https://ollama.com, then: ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
# Keep the model loaded in RAM between questions (faster answers). Use -1 to never unload.
OLLAMA_KEEP_ALIVE=30m
# Context window in tokens (larger = more retrieved text fits, but more RAM)
OLLAMA_NUM_CTX=4096

# --- Gemini settings (used when LLM_BACKEND=gemini) ---
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Knowledge base / training ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_DIR=knowledge_base/faiss_index
RAW_DOCS_DIR=data/knowledge_base_docs
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
EMBED_BATCH_SIZE=32
RESPONSE_CACHE_SIZE=128
